# ==============================================================================
# LEARN DEBT AI - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and configure with your credentials:
# ==============================================================================

# MongoDB Atlas Cloud Database Connection
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/learndebt?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/learndebt?retryWrites=true&w=majority
MONGODB_DATABASE=learndebt

# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Security
JWT_SECRET=learndebt_super_secret_jwt_key_2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Demo Mode
DEMO_PAYMENT_MODE=true
